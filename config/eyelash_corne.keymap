#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#define BEPO 0
#define LOWER 1
#define RAISE 2
#define NUMBER 3

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

 / {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    keymap {
        compatible = "zmk,keymap";

        bepo_layer {
            display-name = "BEPO";
            bindings = <
                // Ligne du haut gauche                                                                                                     // Ligne du haut droite
                &kp ESC         &kp B        &unicode 0x00E9 &kp P          &kp O         &kp M                             &kp UP                &kp W          &kp V           &kp D           &kp L         &kp J         &kp ESC
                // Ligne du milieu gauche                                                                                                   // Ligne du milieu droite
                &kp CAPSLOCK    &mt LGUI A   &mt LALT U      &mt LCTRL I    &mt LSHIFT E  &kp COMMA               &kp LEFT  &kp ENTER  &kp RIGHT  &kp C          &mt LSHIFT T    &mt LCTRL S     &mt LALT R    &mt LGUI N    &kp CAPSLOCK
                // Ligne du bas gauche                                                                                                      // Ligne du bas droite
                &none           &kp Z        &kp Y           &kp X          &kp DOT       &kp K       &kp SPACE             &kp DOWN              &kp SQT        &kp Q           &kp G           &kp H         &kp F         &none
                // Thumbs (gauche puis droite, 3 par main)
                                                             &lt 3 ESC      &lt 1 TAB     &kp SPACE                                               &kp BSPC       &lt 2 ENTER     &kp LGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
                &none      &kp PIPE        &kp DCIR        &kp AMPR  &unicode 0x0153 &unicode 0x00E8                              &mmv MOVE_UP                       &mkp LCLK   &kp HOME     &kp END        &kp MS_WH_DOWN &kp MS_WH_UP   &kp PGUP
                &none      &unicode 0x00E6 &unicode 0x00F9 &kp DIAE  &kp EURO        &kp DLR                      &mmv MOVE_LEFT  &mkp LCLK      &mmv MOVE_RIGHT     &mkp MCLK   &kp LEFT     &kp DOWN       &kp UP         &kp RIGHT      &kp PGDN
                &none      &unicode 0x00C0 &kp CUT         &kp COPY  &kp PASTE       &unicode 0x00E7  &kp C_MUTE                  &mmv MOVE_DOWN                     &mkp RCLK   &kp LSHIFT   &kp LCTRL      &kp LALT       &none          &none
                                                           &none     &none           &none                                                                           &none       &none        &kp LGUI
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
                &none      &kp DQUO     &kp LABK       &kp RABK     &kp LPRN      &kp RPRN                             &mmv MOVE_UP                    &kp AT     &kp PLUS     &kp MINUS      &kp SLASH    &kp ASTR      &none
                &none      &kp GRAVE    &kp LCBR       &kp RCBR     &kp LBRC      &kp RBRC             &mmv MOVE_LEFT  &mkp LCLK      &mmv MOVE_RIGHT  &kp TILDE  &kp EQUAL    &kp PERCENT    &kp BSLS     &kp HASH      &none
                &none      &kp PIPE     &kp LALT       &kp LCTRL    &kp LSHIFT    &none     &kp C_MUTE                 &mmv MOVE_DOWN                  &kp COLON  &kp SCLN     &kp QUES       &kp EXLM     &kp AMPR      &none
                                                       &none        &none         &kp UNDS                                                             &none      &none        &none
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        number_layer {
            display-name = "NUMBER";
            bindings = <
                &kp F1     &kp F2   &kp F3         &kp F4       &kp F5        &kp F6                                    &mmv MOVE_UP                       &kp PLUS   &kp 7   &kp 8    &kp 9  &kp SLASH   &kp PERCENT
                &kp F7     &kp F8   &kp F9         &kp F10      &kp F11       &kp F12                   &mmv MOVE_LEFT  &mkp LCLK      &mmv MOVE_RIGHT     &kp MINUS  &kp 4   &kp 5    &kp 6  &kp ASTRK   &kp ENTER
                &none      &none    &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2  &bt BT_SEL 3  &kp C_MUTE                  &mmv MOVE_DOWN                     &kp 0      &kp 1   &kp 2    &kp 3  &kp EQUAL   &none
                                                   &none        &none         &none                                                                        &kp BSPC   &none   &kp LGUI
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
    
